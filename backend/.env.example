# ─── DATABASE CONFIGURATION ───────────────────────────────────────
DATABASE_URL=postgresql://kicks_user:YOUR_DB_PASSWORD@localhost:5433/kicks_mtaani

# ─── DOCKER DATABASE CREDENTIALS ─────────────────────────────────
DB_USER=kicks_user
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=kicks_mtaani

# ─── AUTHENTICATION & SECURITY KEYS ──────────────────────────────
ADMIN_API_KEY=PASTE_FIRST_GENERATED_KEY
JWT_SECRET_KEY=PASTE_SECOND_GENERATED_KEY

# ─── CORS CONFIGURATION ──────────────────────────────────────────
ALLOWED_ORIGINS=https://kariuki14.github.io,http://localhost,http://127.0.0.1,http://127.0.0.1:5500,http://localhost:5500,http://localhost:8080,http://127.0.0.1:8080

# ─── FRONTEND PORT ────────────────────────────────────────────────
FRONTEND_PORT=8080

# ─── SEED / SCRIPTS BASE URL ─────────────────────────────────────
BASE_URL=http://127.0.0.1:8000/api

# ─── ENVIRONMENT ─────────────────────────────────────────────────
ENVIRONMENT=development