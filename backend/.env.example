# ─── DATABASE CONFIGURATION ───────────────────────────────────────
# Local SQLite: sqlite:///./kicks_mtaani.db
# Production PostgreSQL (Render / Neon / Supabase):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./kicks_mtaani.db

# ─── AUTHENTICATION & SECURITY KEYS ──────────────────────────────
# Generate secure random strings using: openssl rand -hex 32
ADMIN_API_KEY=REPLACE_WITH_SECURE_ADMIN_API_KEY_HEX_32
JWT_SECRET_KEY=REPLACE_WITH_SECURE_JWT_SECRET_KEY_HEX_32

# ─── CORS CONFIGURATION ──────────────────────────────────────────
# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=https://kariuki14.github.io,http://127.0.0.1:5500,http://localhost:5500

# ─── SEED / SCRIPTS BASE URL ─────────────────────────────────────
BASE_URL=http://127.0.0.1:8000/api

